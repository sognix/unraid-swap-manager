<div id="loopwarn" style="display:none; border:1px solid #c0392b; padding:8px; margin:8px 0;">
<pre>⚠️ Warning: loop mode (not recommended)

You chose loop mode for a swapfile on btrfs (e.g. on a RAID1 cache).
The kernel refuses a direct swapfile there because swap needs a fixed
block mapping, which btrfs cannot guarantee with several devices or a
RAID data profile ("swapfile must have single data profile" in dmesg).
Loop mode bypasses that check but does not remove its background, and it
is neither tested nor supported:

 - Writes go through the loop device and the btrfs write path. That path
   can itself request memory under memory pressure.
 - The stall risk sits exactly at the moment memory is needed.
 - In the worst case the system locks up instead of relieving itself.

Recommended alternatives: a single-device btrfs pool (nocow), an XFS pool,
or a small dedicated SSD as its own pool.</pre>
</div>

<script src="/plugins/swap-manager/include/history.js"></script>
<script>
var swapAjax = '/plugins/swap-manager/include/exec.php';
var swapRunning = null; // action currently running in the background

function swapStatus() { $.post(swapAjax, {action: 'status'}, function(r) { $('#swapstatus').text(r); }); }

function swapMsg(text, ok) {
  $('#swapmsg').text(text).css('color', ok === undefined ? '' : (ok ? '#2e7d32' : '#c0392b'));
}

function swapButtons(r) {
  var active = /swap=active/.test(r), present = /file=present/.test(r);
  $('#btn-on').prop('disabled', active || !present);
  $('#btn-off').prop('disabled', !active);
  $('#btn-delete').prop('disabled', active || !present);
}

// while an action runs, poll fast (2s); when the lock is free again the action is done
function swapState() {
  $.post(swapAjax, {action: 'state'}, function(r) {
    swapButtons(r);
    if (swapRunning) {
      if (/busy=yes/.test(r)) { setTimeout(swapState, 2000); return; }
      var a = swapRunning; swapRunning = null;
      swapDone(a, r);
    }
  });
}

function swapDone(a, r) {
  var active = /swap=active/.test(r), present = /file=present/.test(r);
  if (a === 'create' && active) {
    swapMsg('Swap active: deactivate swap, delete old swapfile, create new swapfile, activate swap', false);
    return swapStatus();
  }
  if (a === 'create')  { if (present) swapMsg('Swapfile created', true); else swapMsg('Creating the swapfile failed - see log below', false); }
  if (a === 'on')      { if (active) swapMsg('Swap enabled', true); else swapMsg('Enabling swap failed - see log below', false); }
  if (a === 'off')     { if (!active) swapMsg('Swap disabled', true); else swapMsg('Disabling swap failed - see log below', false); }
  if (a === 'delete')  { if (!present) swapMsg('Swapfile deleted', true); else swapMsg('Deleting the swapfile failed - see log below', false); }
  swapStatus();
}

function swapSwappinessDefault() { $('input[name="#swappiness"]').val('10'); }
function swapSwappiness() { // the swappiness field has its own save button - the only writer for this value
  $.post(swapAjax, {action: 'swappiness', swappiness: $('input[name="#swappiness"]').val()},
    function(r) { swapMsg(r, !/invalid|Error/i.test(r)); })
   .fail(function(x) { swapMsg('Error ' + x.status, false); });
}
// the history fields have their own buttons, like swappiness: Default only fills in the
// defaults, Save stores them and restarts/stops the sampler
var swapHistDefaults = <?=json_encode(array_intersect_key(@parse_ini_file("/usr/local/emhttp/plugins/$plugin/default.cfg") ?: [], array_flip(['history','history_interval','history_range'])))?>;
var swapHistGraph = null;
function swapHistoryDefault() {
  $.each(swapHistDefaults, function(k, v) { $('[name="#' + k + '"]').val(v); });
}
function swapHistorySave() {
  var data = {action: 'history_settings'};
  ['history', 'history_interval', 'history_range'].forEach(function(k) { data[k] = $('[name="#' + k + '"]').val(); });
  $.post(swapAjax, data, function(r) {
    swapMsg(r, true);
    $('#swaphistint').text(data.history_interval);
    $('#swaphist').toggle(data.history === 'yes');
    if (data.history === 'yes') {
      if (swapHistGraph) swapHistGraph.range(+data.history_range);
      else swapHistGraph = swapHistory('#swaphistchart', {height: 160, range: +data.history_range});
    }
  }).fail(function(x) { swapMsg(x.responseText || 'Error ' + x.status, false); });
}
function swapAction(a) {
  var data = {action: a};
  if (a === 'create') { // create is coupled to the swap fields: send the values shown on the page
    ['size_gb','location','name','fs','zpool','bind_mode'].forEach(function(k) {
      var el = $('[name="#'+k+'"]');
      if (el.length) data[k] = el.val();
    });
    swapMsg('Creating the swapfile - this can take a while...');
  } else if (a === 'on') swapMsg('Enabling swap...');
  else if (a === 'off') swapMsg('Disabling swap - with used swap this can take minutes...');
  else swapMsg('Deleting the swapfile...');
  swapRunning = a;
  $.post(swapAjax, data, function() { setTimeout(swapState, 1000); })
   .fail(function(x) { swapRunning = null; swapMsg('Error ' + x.status, false); });
}
$(function() {
  var sel = $('select[name="#bind_mode"]');
  function toggleWarn() { $('#loopwarn').toggle(sel.val() === 'loop'); }
  sel.on('change', toggleWarn); toggleWarn();
  swapStatus(); setInterval(swapStatus, 5000);
  swapState(); setInterval(function() { if (!swapRunning) swapState(); }, 5000);
  if ($('#swaphist').is(':visible')) swapHistGraph = swapHistory('#swaphistchart', {height: 160, range: <?=(int)($cfg['history_range'] ?? 300)?>});
});
</script>
